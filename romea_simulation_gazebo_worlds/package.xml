<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">
  <name>romea_simulation_gazebo_worlds</name>
  <version>0.0.0</version>
  <description>Package containing gazebo worlds used by Romea team</description>


  <maintainer email="jean.laneurit@inrae.fr">Jean Laneurit</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend condition="$ROS_DISTRO &lt;= iron">gazebo_ros</depend>
  <depend condition="$ROS_DISTRO &gt; iron">ros_gz_sim</depend>
  <exec_depend condition="$ROS_DISTRO &gt; iron">ros_gz</exec_depend>
  <exec_depend condition="$ROS_DISTRO &lt;= iron">gazebo_dev</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

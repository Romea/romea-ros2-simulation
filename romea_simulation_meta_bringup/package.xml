<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>romea_simulation_meta_bringup</name>
  <version>0.0.0</version>
  <description>Package containing simulation launch files.</description>

  <maintainer email="jean.laneurit@inrae.fr">Jean Laneurit</maintainer>

  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>romea_mobile_base_meta_bringup</exec_depend>

  <exec_depend>romea_common_meta_bringup</exec_depend>
  <exec_depend>romea_simulation_gazebo_worlds</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <exec_depend condition="$ROS_DISTRO &lt;= iron">gazebo_ros</exec_depend>
  <exec_depend condition="$ROS_DISTRO &lt;= iron">gazebo_plugins</exec_depend>
  <exec_depend condition="$ROS_DISTRO &gt; iron">ros_gz</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
